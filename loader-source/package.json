{
  "name": "socket-loader",
  "version": "1.2.0",
  "description": "Лоадер Socket Client: ставит Minecraft 1.21.4 с Fabric и управляет модами",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "obfuscate": "node scripts/pack.js",
    "dist": "node scripts/prepare-bundle.js && node scripts/pack.js --pack",
    "bundle": "node scripts/prepare-bundle.js"
  },
  "build": {
    "appId": "ru.socketclient.loader",
    "productName": "Socket Loader",
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/ui/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Socket Client",
      "artifactName": "SocketClient-Loader-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Socket loader.exe"
    },
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "bundle",
        "to": "socket-bundle"
      }
    ],
    "asar": true,
    "electronVersion": "44.4.3"
  },
  "dependencies": {
    "adm-zip": "0.6.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "javascript-obfuscator": "5.6.0"
  },
  "allowScripts": {
    "electron@44.0.0": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IIchikadev/Socket.git"
  }
}
