{
  "accessWidener": "socket.accesswidener",
  "schemaVersion": 1,
  "id": "socket",
  "version": "${version}",
  "name": "Socket Client",
  "description": "Визуальный клиент Socket для Minecraft",
  "authors": [
    "IIchika",
    "Ramixy"
  ],
  "contact": {
    "sources": "https://github.com/IIchikadev/Socket"
  },
  "license": "MIT",
  "icon": "assets/socket/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "platform.Initializer"
    ]
  },
  "mixins": [
    "socket.mixins.json"
  ],
  "custom": {
    "socket:discordClientId": "1555668846294335598"
  },
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
